	measure '% Scheduled in 0-7 Days Trend' =
			VAR Mode = [Trend Mode Selected]
			VAR AxisDateTime = MAX('Appt Time And Count'[datecreated])
			VAR AxisDate = DATE(YEAR(AxisDateTime), MONTH(AxisDateTime), DAY(AxisDateTime))
			VAR IsWeekStart = WEEKDAY(AxisDate, 2) = 1
			VAR IsMonthEnd = AxisDate = EOMONTH(AxisDate, 0)
			VAR IsPoint = IF(Mode = "WoW", IsWeekStart, IsMonthEnd)
			RETURN
			    IF(IsPoint, [% Scheduled in 0-7 Days])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Trend measures
		lineageTag: 8bfe32ea-c21f-43c6-9ddf-a35be3c6f130

