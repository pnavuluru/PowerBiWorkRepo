	measure 'Lower End TTSe' = percentile.inc('Appt Time And Count'[total_time_to_seen], 0.1)
		lineageTag: edece4a3-2de6-4b86-88f8-139c2b9e9c83

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Conversion %' = sum('Appt Time And Count'[funded]) / sum('Appt Time And Count'[Counter])
		formatString: 0%;-0%;0%
		lineageTag: 153b7408-debd-4420-9e12-ff9fb38fe855

	measure 'Canceled %' = sum('Appt Time And Count'[canceled]) / sum('Appt Time And Count'[Counter])
		formatString: 0%;-0%;0%
		lineageTag: ad0af3d9-6235-4276-a69a-9c62b2dd45f7

	measure Success% = SUM('Appt Time And Count'[success_result])/sum('Appt Time And Count'[Counter])
		formatString: 0%;-0%;0%
		lineageTag: 93160b50-8148-4ad7-9a9c-ee3acbc27b58

	measure 'Total IDs' = DISTINCTCOUNT('Appt Time And Count'[id])
		formatString: 0
		displayFolder: Schedule measures
		lineageTag: 4797454d-738b-4cab-95c3-18c5fc9d0a29

	measure 'Successfully Scheduled' =
			
			CALCULATE(
			    DISTINCTCOUNT('Appt Time And Count'[id]),
			    KEEPFILTERS(
			        FILTER(
			            'Appt Time And Count',
			            NOT ISBLANK('Appt Time And Count'[first_schedule_date])
			        )
			    )
			)
		formatString: 0
		displayFolder: Schedule measures
		lineageTag: 68eb5ace-0db6-4e6e-822a-f6d4914729a9

	measure '% Successfully Scheduled' = DIVIDE([Successfully Scheduled], [Total IDs])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Schedule measures
		lineageTag: e27e515b-9fb2-4b57-99a3-d72d036fb15d

	measure 'SLA Data As Of Date' =
			
			VAR MaxCreated =
			    CALCULATE(MAX('Appt Time And Count'[datecreated]), ALL('Appt Time And Count'))
			VAR MaxScheduled =
			    CALCULATE(MAX('Appt Time And Count'[first_schedule_date]), ALL('Appt Time And Count'))
			VAR MaxFunded =
			    CALCULATE(MAX('Appt Time And Count'[fundeddate]), ALL('Appt Time And Count'))
			RETURN
			    MAX(MaxCreated, MAX(MaxScheduled, MaxFunded))
		formatString: General Date
		lineageTag: 21740bbb-6e48-4127-95ae-2e1f27877109

	measure 'Trend Mode Selected' = SELECTEDVALUE('Trend Granularity'[Mode], "MoM")
		displayFolder: Trend measures
		lineageTag: b6e9cc0d-b814-44bf-a224-77d703588e81

	measure '% Successfully Scheduled Trend' =
			
			VAR Mode = [Trend Mode Selected]
			VAR AxisDateTime = MAX('Appt Time And Count'[datecreated])
			VAR AxisDate = DATE(YEAR(AxisDateTime), MONTH(AxisDateTime), DAY(AxisDateTime))
			VAR IsWeekStart = WEEKDAY(AxisDate, 2) = 1
			VAR IsMonthEnd = AxisDate = EOMONTH(AxisDate, 0)
			VAR IsPoint = IF(Mode = "WoW", IsWeekStart, IsMonthEnd)
			RETURN
			    IF(IsPoint, [% Successfully Scheduled])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Trend measures
		lineageTag: 1faf1bdb-7de7-45ff-b0e4-a57827ac4fc6

	measure 'Successfully Funded' =
			
			CALCULATE(
			    DISTINCTCOUNT('Appt Time And Count'[id]),
			    KEEPFILTERS(
			        FILTER(
			            'Appt Time And Count',
			            NOT ISBLANK('Appt Time And Count'[fundeddate])
			        )
			    )
			)
		formatString: 0
		displayFolder: Funded measures
		lineageTag: 5ab06252-dbad-4605-9bcd-45aa7b67dda9

	measure '% Successfully Funded' = DIVIDE([Successfully Funded], [Total IDs])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Funded measures
		lineageTag: bed6f746-31ac-4876-b83f-f358a29ee6f8

	measure '% Successfully Funded Trend' =
			
			VAR Mode = [Trend Mode Selected]
			VAR AxisDateTime = MAX('Appt Time And Count'[datecreated])
			VAR AxisDate = DATE(YEAR(AxisDateTime), MONTH(AxisDateTime), DAY(AxisDateTime))
			VAR IsWeekStart = WEEKDAY(AxisDate, 2) = 1
			VAR IsMonthEnd = AxisDate = EOMONTH(AxisDate, 0)
			VAR IsPoint = IF(Mode = "WoW", IsWeekStart, IsMonthEnd)
			RETURN
			    IF(IsPoint, [% Successfully Funded])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Trend measures
		lineageTag: f6af482e-d308-40d2-ad6d-3da9f41bcbba

	measure '% Funded in 30 Days' =
			
			VAR AsOfDate = [SLA Data As Of Date]
			VAR IsMature =
			    MAX('Appt Time And Count'[datecreated]) <= AsOfDate - 30
			VAR FundedWithin30Days =
			    CALCULATE(
			        DISTINCTCOUNT('Appt Time And Count'[id]),
			        KEEPFILTERS(
			            FILTER(
			                'Appt Time And Count',
			                NOT ISBLANK('Appt Time And Count'[datecreated])
			                    && NOT ISBLANK('Appt Time And Count'[fundeddate])
			                    && DATEDIFF('Appt Time And Count'[datecreated], 'Appt Time And Count'[fundeddate], DAY) >= 0
			                    && DATEDIFF('Appt Time And Count'[datecreated], 'Appt Time And Count'[fundeddate], DAY) <= 30
			            )
			        )
			    )
			RETURN
			    IF(IsMature, DIVIDE(FundedWithin30Days, [Total IDs]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Funded measures
		lineageTag: a3edd1c9-5935-454f-b116-25776eb16c3f

