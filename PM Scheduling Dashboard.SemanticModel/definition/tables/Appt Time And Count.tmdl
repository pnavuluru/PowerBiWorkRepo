	measure 'Flag Direction (by SLA Metric)' =
			VAR MetricName = SELECTEDVALUE('SLA Metric Selector'[Metric], "Scheduled %")
			RETURN IF(MetricName = "Canceled %", -1, 1)
		formatString: 0;-0;0
		displayFolder: SLA comparison\Flags
		lineageTag: 6f8812ba-ea6b-4a5b-8bc4-e66a286c28f0

	measure 'Flag - Metric Diff Good' =
			VAR v = [Metric Diff (Current-Prior)]
			VAR dir = [Flag Direction (by SLA Metric)]
			RETURN IF(dir * v >= 0, 1, 0)
		formatString: 0;-0;0
		displayFolder: SLA comparison\Flags
		lineageTag: 0ddd7805-641b-4b2a-8cf7-1dd7e73af2d7

	measure 'Flag - Impact 1 Good' =
			VAR v = [Impact 1 - Total Contribution (pp)]
