table 'Appt Time And Count'
	lineageTag: 0293f98b-b959-4b13-b8aa-fff89c9bd0fb

	measure 'Average Time To Scheduled' = sum('Appt Time And Count'[total_time_to_schedule]) / sum('Appt Time And Count'[Scheduled])
		lineageTag: de823e72-e50d-418b-a02f-f092e43db878

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Std Dev TTS' = STDEV.P('Appt Time And Count'[total_time_to_schedule])
		lineageTag: c4c5775a-4423-477b-947a-b102b7802657

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Lower End TTS' = PERCENTILE.INC('Appt Time And Count'[total_time_to_schedule],0.1)
		lineageTag: ce698ead-a1a0-4db7-ac62-bf0584444d93

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Upper End TTS' = percentile.inc('Appt Time And Count'[total_time_to_schedule], 0.9)
		lineageTag: 260217be-d787-41f6-a9cc-0c9102d6902a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'First Scheduled %' = sum('Appt Time And Count'[Scheduled]) / sum('Appt Time And Count'[Counter])
		formatString: 0%;-0%;0%
		lineageTag: e879cfe5-d9c9-47b8-9e8f-343ef89cb661

		changedProperty = IsHidden

	measure MovingAverageLast6Weeks =
			
			AVERAGEX(
			    DATESINPERIOD('Appt Time And Count'[first_schedule_Date], LASTDATE('Appt Time And Count'[first_schedule_Date]), -45, DAY),
			    [Total Scheduled]
			)
		lineageTag: 1469e31b-d44f-4e09-b92d-9fc686ba58e3

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Scheduled' = sum('Appt Time And Count'[Scheduled])
		formatString: 0
		lineageTag: cc7c6b93-bf12-4e59-82b1-2fbe7b37eeed

		changedProperty = IsHidden

	measure 'Total Appts' = sum('Appt Time And Count'[Counter])
		formatString: 0
		lineageTag: 3de68747-f89b-400f-8975-b8c37c3ec344

		changedProperty = IsHidden

	measure 'Upper End TTSe' = percentile.inc('Appt Time And Count'[total_time_to_seen], 0.9)
		lineageTag: f51f25d5-5c36-440c-bd1d-c655a6dd912e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Upper End TTF' = percentile.inc('Appt Time And Count'[total_time_to_bill], 0.9)
