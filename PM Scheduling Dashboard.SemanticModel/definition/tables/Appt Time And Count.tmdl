	partition 'Appt Time And Count-ec3b9fc5-c491-4a2b-bd71-199b3abeefe7' = m
		mode: import
		source =
				let
				    Source = Sql.Database("medprdsql02.canyonmedicalbilling.com", "financemetrics", [Query="DECLARE @startdate AS date#(lf)SET @startdate = '2022-01-01'#(lf)#(lf)/* Scheduling analysis  */#(lf)#(lf)#(lf)IF OBJECT_ID('tempdb..#base') IS NOT NULL DROP TABLE #base#(lf)IF OBJECT_ID('tempdb..#firstsched') IS NOT NULL DROP TABLE #firstsched#(lf)IF OBJECT_ID('tempdb..#firstschedbase') IS NOT NULL DROP TABLE #firstschedbase#(lf)IF OBJECT_ID('tempdb..#requests') IS NOT NULL DROP TABLE #requests#(lf)IF OBJECT_ID('tempdb..#facorigination') IS NOT NULL DROP TABLE #facorigination#(lf)IF OBJECT_ID('tempdb..#firmorigination') IS NOT NULL DROP TABLE #firmorigination#(lf)IF OBJECT_ID('tempdb..#stateorigination') IS NOT NULL DROP TABLE #stateorigination#(lf)IF OBJECT_ID('tempdb..#reqbyfac') IS NOT NULL DROP TABLE #reqbyfac#(lf)IF OBJECT_ID('tempdb..#reqbyfirm') IS NOT NULL DROP TABLE #reqbyfirm#(lf)IF OBJECT_ID('tempdb..#reqbystate') IS NOT NULL DROP TABLE #reqbystate#(lf)#(lf)#(lf)select#(lf)distinct a.SourceId,#(lf)(select min(b.createddate) as scheduled from MoveDocsV4.dbo.AuditLogs b where module = 'Appointment Request' and newvalue in ('Appointment Scheduled','Patient Seen')#(lf)and a.sourceid = b.sourceid) as date_scheduled#(lf)into #requests#(lf)from MoveDocsV4.dbo.AuditLogs a#(lf)where module = 'Appointment Request'#(lf)and [action] = 'New Appointment Request'#(lf)#(lf)SELECT #(lf)    fs.sourceid, #(lf)    fs.first_schedule_date,#(lf)    (SELECT TOP 1 al.createdby #(lf)     FROM MoveDocsV4.dbo.AuditLogs al#(lf)     WHERE al.sourceid = fs.sourceid #(lf)       AND al.newvalue IN ('Appointment Scheduled', 'No Show', 'Reschedule', 'Reschedule Needed', 'Patient seen')#(lf)     ORDER BY al.createddate ASC) AS createdby#(lf)INTO #firstschedbase#(lf)FROM #(lf)    (SELECT #(lf)         sourceid, #(lf)         MIN(createddate) AS first_schedule_date#(lf)     FROM MoveDocsV4.dbo.AuditLogs#(lf)     WHERE newvalue IN ('Appointment Scheduled', 'No Show', 'Reschedule', 'Reschedule Needed', 'Patient seen')#(lf)     GROUP BY sourceid) fs#(lf)#(lf)Drop table if exists #firstsched#(lf)select a.*, #(lf)case when anu.usertype is null then 'External Undefined' #(lf)#(tab) when a.createdby not like '%@movedocs.com' and a.createdby not like '%@medportbilling.com' and a.createdby not like '%@lienservicinggroup.com'#(lf)#(tab)and a.createdby not like '%@medport.com' and a.createdby not like '%@canyonmedicalbilling.com' and a.createdby not like '%@trimed-billing.com'#(lf)#(tab)and a.createdby not like 'ssomb%' and a.createdby not like 'sssomb%' and a.createdby not like '%@atticusbilling.com%' and a.createdby not like '%@keyhealth.net%' #(lf)#(tab)and a.createdby not like '%@thetriosolution%' and a.createdby not like '%@syndeocare.com%' and a.createdby not like '%@oasisfinancial.com%' and a.createdby not like '%@librasolutionsgroup%' #(lf)#(tab)then usertype else 'Internal' end as 'ScheduledBy',#(lf)case when anu.usertype is null then 'External Undefined' #(lf)#(tab) when a.createdby not like '%@movedocs.com' and a.createdby not like '%@medportbilling.com' and a.createdby not like '%@lienservicinggroup.com'#(lf)#(tab)and a.createdby not like '%@medport.com' and a.createdby not like '%@canyonmedicalbilling.com' and a.createdby not like '%@trimed-billing.com'#(lf)#(tab)and a.createdby not like 'ssomb%' and a.createdby not like 'sssomb%' and a.createdby not like '%@atticusbilling.com%' and a.createdby not like '%@keyhealth.net%' #(lf)#(tab)and a.createdby not like '%@thetriosolution%' and a.createdby not like '%@syndeocare.com%' and a.createdby not like '%@oasisfinancial.com%' and a.createdby not like '%@librasolutionsgroup%' #(lf)#(tab)then usertype else left(a.createdby, charindex('@', a.createdby)-1) end as internal_user#(lf)#(tab)into #firstsched#(lf)#(tab)from #firstschedbase a#(lf)#(tab)left join MoveDocsV4.dbo.AspNetUsers anu on anu.username = a.createdby#(lf)#(tab)--where anu.usertype = 'firm'#(lf)#(tab)order by first_schedule_date desc#(lf)#(lf)#(lf)Drop table if exists #proctype#(lf)SELECT distinct f.id,#(lf)f.Name,#(lf)f.facilitytype,#(lf)case when f.facilitytype = 'Physical Therapy' then 'PT'#(lf)when f.facilitytype = 'Imaging Facility' then 'Imaging'#(lf)when f.FacilityType = 'Initial' then 'Initial'#(lf)Else 'Specialties/Other' End as 'Procedure_Type',#(lf)coalesce(e.name, f.name) as 'Enterprise_Name'#(lf)into #proctype#(lf)FROM financemetrics.dbo.facilities f#(lf)left join FinanceMetrics.dbo.Enterprises e on f.EnterpriseID = e.Id#(lf)#(lf)Drop table if exists #untiedAcct#(lf)SELECT#(lf)a.id,#(lf)(select min(accountid) from FinanceMetrics.dbo._snapshot_CIMIAnalysisAnalytics s where s.DOB = d.DOB and s.DateOfLoss = c.DateOfLoss and s.ServiceDate = aa.ServiceDate#(lf)and s.ServiceDate > a.DateCreated and s.ServiceDate <= dateadd(day, 180, a.DateCreated) and aa.sourcesystemid = s.sourcesystemid and s.OriginalDueDate >= a.DateCreated#(lf)and ((a.firmid is null and fc.name = s.facility) or a.firmid = s.firmid) and OriginalDebt > 0 and a.DOSAccountId <> s.AccountId#(lf)and s.location not like '%grs%' and#(tab)#(lf)s.location not in ('IFA','IFI','OHF','OHC','TMC','TDC')#(tab)#(tab)#(tab)#(tab)#(lf)) as 'untied_account_id'#(lf)INTO #untiedAcct#(lf)FROM MoveDocsV4.dbo.AppointmentRequests a#(lf)left join FinanceMetrics.dbo.accounts aa on a.dosaccountid = aa.id#(lf)LEFT JOIN FinanceMetrics.dbo._snapshot_CIMIAnalysisAnalytics caa on caa.accountid = aa.id#(lf)left join financemetrics.dbo.cases c on aa.caseid= c.id#(lf)left join financemetrics.dbo.debtors d on c.debtorid = d.id and c.sourcesystemid= d.sourcesystemid#(lf)left join financemetrics.dbo.Facilities fc on aa.facilityid = fc.Id and aa.SourceSystemID = fc.SourceSystemID#(lf)where DOSAccountId is not null #(lf)Drop table if exists #firstvisit#(lf)SELECT #(lf)caseid, #(lf)min(id) as 'first_visit'#(lf)into #firstvisit#(lf)FROM MoveDocsV4.dbo.AppointmentRequests#(lf)where status not in ('began','canceled - location changed') and Removed = 0#(lf)group by caseid#(lf)#(lf)#(lf)Drop table if exists #base#(lf)select a.id, #(lf)a.status,#(lf)a.DateCreated, #(lf)first_schedule_date, #(lf)fs.internal_user,#(lf)a.appointmentdate as 'appt_Date',#(lf)case when a.Status in ('patient seen','Appointment Scheduled','Reschedule') or aa.OriginalDueDate is not null or s.OriginalDueDate is not null then 1 else 0 end as 'success_result',#(lf)r.date_scheduled as 'conversiondate',#(lf)case when a.Status like '%canceled%' then 1 else 0 end as 'canceled',#(lf)case when a.Status like '%canceled%' #(lf)#(tab) and anu.usertype is null then 'External Undefined' #(lf)#(tab) when a.Status like '%canceled%' and al.createdby not like '%@movedocs.com' and al.createdby not like '%@medportbilling.com' and al.createdby not like '%@lienservicinggroup.com'#(lf)#(tab)and al.createdby not like '%@medport.com' and al.createdby not like '%@canyonmedicalbilling.com' and al.createdby not like '%@trimed-billing.com'#(lf)#(tab)and al.createdby not like 'ssomb%' and al.createdby not like 'sssomb%' and al.createdby not like '%@atticusbilling.com%' and al.createdby not like '%@keyhealth.net%' #(lf)#(tab)and al.createdby not like '%@thetriosolution%' and al.createdby not like '%@mdunderwriting.com%' and al.createdby not like '%@syndeocare.com%' and al.createdby not like '%@oasisfinancial.com%' and al.createdby not like '%@librasolutionsgroup%' #(lf)#(tab)then anu.username else 'Internal' end as 'Canceled_username',#(lf)case when a.Status like '%canceled%' #(lf)#(tab) and anu.usertype is null then 'External Undefined' #(lf)#(tab) when a.Status like '%canceled%' and al.createdby not like '%@movedocs.com' and al.createdby not like '%@medportbilling.com' and al.createdby not like '%@lienservicinggroup.com'#(lf)#(tab)and al.createdby not like '%@medport.com' and al.createdby not like '%@canyonmedicalbilling.com' and al.createdby not like '%@trimed-billing.com'#(lf)#(tab)and al.createdby not like 'ssomb%' and al.createdby not like 'sssomb%' and al.createdby not like '%@atticusbilling.com%' and al.createdby not like '%@keyhealth.net%' #(lf)#(tab)and al.createdby not like '%@thetriosolution%' and al.createdby not like '%@mdunderwriting.com%' and al.createdby not like '%@syndeocare.com%' and al.createdby not like '%@oasisfinancial.com%' and al.createdby not like '%@librasolutionsgroup%' #(lf)#(tab)then anu.usertype else 'Internal' end as 'Canceled_usertype',#(lf)case when a.Status = 'Canceled' then 1 else 0 end as 'canceled_status',#(lf)case when a.Status = 'Canceled by Patient' then 1 else 0 end as 'canceled_by_pt',#(lf)case when a.Status like '%canceled%' and first_schedule_date is not null then 1 else 0 end as 'scheduled_canceled',#(lf)coalesce(aa.originalduedate,s.originalduedate) as 'fundeddate',#(lf)case when datediff(day,a.datecreated, first_schedule_date) >=90 then null #(lf)when datepart(dw, a.DateCreated) = 1 #(lf)then (datediff(HOUR,a.datecreated,first_schedule_date) * 1.0 / 24) - 1 - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,first_schedule_date)))#(lf)else (datediff(HOUR,a.datecreated,first_schedule_date) * 1.0 / 24) - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,first_schedule_date))) end as 'Schedule_Time',#(lf)case when datediff(day,a.datecreated, coalesce(AppointmentDate,aa.servicedate, s.servicedate)) >=90 then null #(lf)when datepart(dw, a.DateCreated) = 1 #(lf)then (datediff(HOUR,a.datecreated,coalesce(AppointmentDate,aa.servicedate, s.servicedate)) * 1.0 / 24) - 1 - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,coalesce(AppointmentDate,aa.servicedate, s.servicedate))))#(lf)else (datediff(HOUR,a.datecreated,coalesce(AppointmentDate,aa.servicedate, s.servicedate)) * 1.0 / 24) - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,coalesce(AppointmentDate,aa.servicedate, s.servicedate)))) end as 'Time_to_seen', #(lf)case when datepart(dw, a.DateCreated) = 1 and aa.datecreated > a.datecreated and a.status = 'Patient Seen'#(lf)then (datediff(HOUR,a.datecreated,aa.datecreated) * 1.0 / 24) - 1 - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,aa.datecreated)))#(lf)when aa.datecreated > a.datecreated and a.status = 'Patient Seen' #(lf)then (datediff(HOUR,a.datecreated,aa.datecreated) * 1.0 / 24) - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,aa.datecreated))) #(lf)else null end as 'Time_to_acct', #(lf)case when datepart(dw, a.DateCreated) = 1 and a.datecreated < coalesce(aa.originalduedate,s.originalduedate) and a.status = 'Patient Seen'#(lf)then (datediff(HOUR,a.datecreated,aa.originalduedate) * 1.0 / 24) - 1 - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,aa.originalduedate)))#(lf)when a.datecreated < coalesce(aa.originalduedate,s.originalduedate) and a.status = 'Patient Seen' #(lf)then (datediff(HOUR,a.datecreated,coalesce(aa.originalduedate,s.originalduedate)) * 1.0 / 24) - (2*DATEDIFF(wk, convert(date,a.datecreated),convert(date,coalesce(aa.originalduedate,s.originalduedate)))) #(lf)else null end as 'Time_to_bill', #(lf)case when team = 'CS' then 'Scheduling' else team end as 'Region',  #(lf)case when (a.facilityname like '%select PT%' or a.facilityname like '%select Physical Therapy%') then 'Select PT' else null end as 'SelectPT', #(lf)a.facilityname,#(lf)a.requiresservices,#(lf)cu.fullname as case_coordinator,#(lf)f.State, #(lf)a.FacilityState,#(lf)ScheduledBy,#(lf)--anu.username as canceled_by2,#(lf)--anu.usertype as canceled_usertype2,#(lf)case when a.Status in ('Appointment Scheduled','Patient Seen') then 'Successful'#(lf) when a.status in ('Canceled','Canceled by Patient','Declined by Provider') then 'Not Successful'#(lf) else 'Pending/Reworking' end as 'current_status',#(lf)pt.Procedure_Type,#(lf)pt.FacilityType,#(lf)f.firmname,#(lf)a.lawFirmName,#(lf)a.FacilityId,#(lf)a.FirmId,#(lf)case when fv.first_visit = a.Id then 1 else 0 end as 'first_visit',#(lf)coalesce(e.name,a.facilityname) as 'enterprise_name',#(lf)t.fullname as assigned_user#(lf)into #base#(lf)from movedocsv4.dbo.appointmentrequests a#(lf)LEFT JOIN c3.admin.Users t on t.Id = a.AssignedTo#(lf)left join #requests r on a.Id = r.SourceId#(lf)left join #firstsched fs on fs.sourceid = a.id#(lf)left join analytics.dbo.scheduling_ownership so on so.appt_id = a.id#(lf)left join financemetrics.dbo.accounts aa on aa.id = a.dosaccountid and aa.sourcesystemid = 2#(lf)left join c3.debtor.cases dc on dc.id = a.caseid#(lf)LEFT JOIN [C3].[admin].[Users] cu ON cu.Id = dc.CaseCoordinatorUserId#(lf)left join financemetrics.dbo.Facilities fc on aa.facilityid = fc.Id and aa.SourceSystemID = fc.SourceSystemID#(lf)left join financemetrics.dbo.enterprises e on fc.DefaultEnterpriseId = e.Id and aa.SourceSystemID = e.SourceSystemID#(lf)left join #proctype pt on pt.id = a.facilityid#(lf)left join [financemetrics].[dbo].[Firms] f on a.FirmId = f.id and aa.SourceSystemID = f.SourceSystemID#(lf)left join #untiedAcct ua on a.id = ua.Id#(lf)left join #firstvisit fv on a.caseid = fv.caseid#(lf)left join (SELECT * FROM FinanceMetrics.dbo._snapshot_CIMIAnalysisAnalytics where originaldebt > 0 #(lf)and isnull(location,'j')  not like '%grs%'#(tab)and#(tab)#(lf)isnull(location,'j') not in ('IFA','IFI','OHF','OHC','TMC','TDC')#(lf)) s on ua.untied_account_id = s.AccountId#(lf)left join (Select a.*#(lf)#(tab)#(tab)#(tab)from MoveDocsV4.dbo.AuditLogs a#(lf)#(tab)#(tab)#(tab)left join (Select sourceid, #(lf)#(tab)#(tab)#(tab)max(id) as latest_canceled_record #(lf)#(tab)#(tab)#(tab)from MoveDocsV4.dbo.AuditLogs #(lf)#(tab)#(tab)#(tab)where newvalue not like '%canceled - location%' #(lf)#(tab)#(tab)#(tab)and newvalue like '%Canceled%'#(lf)#(tab)#(tab)#(tab)group by SourceId) b on b.latest_canceled_record = a.id #(lf)#(tab)#(tab)#(tab)where b.latest_canceled_record is not null) al on al.SourceId = a.id#(lf)left join MoveDocsV4.dbo.AspNetUsers anu on anu.username = al.createdby #(lf)where a.status not like '%Began%' #(lf)and a.status not like '%canceled - location%'  #(lf)and a.Removed = 0#(lf)--and a.status like '%canceled%'#(lf)order by datecreated desc#(lf)#(lf)#(lf)#(lf)-----RANKINGS BASED ON ORIGINATION-------------#(lf)SELECT #(lf)f.id,#(lf)dense_rank() OVER (ORDER BY sum(cost) DESC) AS rank,#(lf)sum(cost) as 'Total_Origination'#(lf)into #facorigination#(lf)FROM [financemetrics].[dbo].[_snapshot_CIMIAnalysisAnalytics] c#(lf)LEFT JOIN financemetrics.dbo.Facilities f on c.Facility = f.Name#(lf)where --location <> 'Tri' and #(lf)originalduedate >= @startdate#(lf)group by f.id#(lf)#(lf)SELECT #(lf)firmid,#(lf)sum(cost) as 'Total_Origination',#(lf)dense_rank() OVER (ORDER BY sum(cost) DESC) AS rank#(lf)into #firmorigination#(lf)FROM [financemetrics].[dbo].[_snapshot_CIMIAnalysisAnalytics] #(lf)where --location <> 'Tri' and #(lf)originalduedate >= @startdate#(lf)group by FirmID#(lf)#(lf)SELECT FacilityState,#(lf)sum(cost) as 'Total_Origination',#(lf)dense_rank() OVER (ORDER BY sum(cost) DESC) AS rank#(lf)into #stateorigination#(lf)FROM [financemetrics].[dbo].[_snapshot_CIMIAnalysisAnalytics]#(lf)where isnull(location,'j')  not like '%grs%'#(tab)and#(tab)#(lf)isnull(location,'j') not in ('IFA','IFI','OHF','OHC','TMC','TDC') and#(lf)originalduedate >= @startdate#(lf)group by FacilityState#(lf)#(lf)#(lf)#(lf)------RANKINGS BASED ON REQUESTS------------#(lf)SELECT #(lf)FacilityId,#(lf)count(*) as 'Total_requests',#(lf)Dense_RANK () over (order by count(*) desc) as rank#(lf)into #reqbyfac#(lf)FROM [MoveDocsV4].[dbo].[AppointmentRequests]#(lf)where DateCreated >= @startdate#(lf)group by FacilityId#(lf)#(lf)Select #(lf)firmid,#(lf)DENSE_RANK () over (order by count(*) desc) as rank,#(lf)count(*) as 'Total_requests'#(lf)into #reqbyfirm#(lf)from [MoveDocsV4].[dbo].[AppointmentRequests]#(lf)where datecreated >= @startdate #(lf)group by FirmId#(lf)#(lf)Select FacilityState,#(lf)DENSE_RANK () over (order by count(*) desc) as rank,#(lf)count(*) as 'Total_requests'#(lf)into #reqbystate#(lf)from [MoveDocsV4].[dbo].[AppointmentRequests]#(lf)where datecreated >= @startdate #(lf)group by FacilityState#(lf)#(lf)#(lf)#(lf)select #(lf)distinct#(lf)a.id, #(lf)a.status,#(lf)a.facilityname,#(lf)Selectpt,#(lf)a.FacilityState,#(lf)ScheduledBy,#(lf)internal_user,#(lf)case when v.firm_group = 'Morgan & Morgan' then 'Scheduling' else a.region end as 'region',#(lf)datecreated,#(lf)first_schedule_date,#(lf)appt_date,#(lf)current_status,#(lf)success_result,#(lf)fundeddate,#(lf)cast(datecreated as date) as 'request_day',#(lf)cast(appt_Date as date) as 'appt_day',#(lf)cast(first_schedule_date as date) as 'first_schedule_Day',#(lf)cast(fundeddate as date) as 'funded_Day',#(lf)--first schedule date > 30, 90, 180, 360 then grab schedule time:#(lf)case when first_schedule_date >= DATEADD(DAY, -30, GETDATE()) then Schedule_Time else null end as 'sched1month',#(lf)case when first_schedule_date >= DATEADD(DAY, -90, GETDATE()) then Schedule_Time else null end as 'sched3month',#(lf)case when first_schedule_date >= DATEADD(DAY, -180, GETDATE()) then Schedule_Time else null end as 'sched6month',#(lf)case when first_schedule_date >= DATEADD(DAY, -360, GETDATE()) then Schedule_Time else null end as 'sched12month',#(lf)cast(DATEADD(DAY, 1 - DATEPART(WEEKDAY, first_schedule_date), first_schedule_date) as date) as 'first_schedule_week',#(lf)cast(DATEADD(DAY, 1 - DATEPART(WEEKDAY, appt_Date), appt_Date) as date) as 'appt_week',#(lf)cast(DATEADD(DAY, 1 - DATEPART(WEEKDAY, datecreated), datecreated) as date) as 'request_week',#(lf)cast(DATEADD(DAY, 1 - DATEPART(WEEKDAY, fundeddate), fundeddate) as date) as 'funded_week',#(lf)EOMONTH(datecreated) as 'request_month',#(lf)eomonth(appt_date) as 'appt_month',#(lf)EOMONTH(first_schedule_date) as 'first_schedule_month',#(lf)EOMONTH(fundeddate) as 'first_funded_month',#(lf)case when first_schedule_date is null then 0 else 1 end as 'Scheduled',#(lf)case when appt_date is null then 0 else 1 end as 'seen',#(lf)case when conversiondate is null then 0 else 1 end as 'converted',#(lf)case when fundeddate is null then 0 else 1 end as 'funded',#(lf)--if conversiondate is not null and datecreated is > 30, 90, 180, 360 then grab conversiondate:#(lf)case when conversiondate is not null and DateCreated >= DATEADD(DAY, -30, GETDATE()) then 1 else null end as 'conv1month',#(lf)case when conversiondate is not null and DateCreated >= DATEADD(DAY, -90, GETDATE()) then 1 else null end as 'conv3month',#(lf)case when conversiondate is not null and DateCreated >= DATEADD(DAY, -180, GETDATE()) then 1 else null end as 'conv6month',#(lf)case when conversiondate is not null and DateCreated >= DATEADD(DAY, -360, GETDATE()) then 1 else null end as 'conv12month',#(lf)--If datecreated is > 30, 90, 180, 360 then 1 end as conversion denominator:#(lf)case when DateCreated >= DATEADD(DAY, -30, GETDATE()) then 1 else null end as 'conv1month_Denominator',#(lf)case when DateCreated >= DATEADD(DAY, -90, GETDATE()) then 1 else null end as 'conv3month_Denominator',#(lf)case when DateCreated >= DATEADD(DAY, -180, GETDATE()) then 1 else null end as 'conv6month_Denominator',#(lf)case when DateCreated >= DATEADD(DAY, -360, GETDATE()) then 1 else null end as 'conv12month_Denominator',#(lf)Schedule_time as 'total_time_to_schedule',#(lf)Time_to_seen as 'total_time_to_seen',#(lf)case when datediff(Day,datecreated,getdate()) < 21 then 0 else 1 end as 'recent_filter',#(lf)Procedure_Type as 'Appointment Type',#(lf)FacilityType,#(lf)a.firmname,#(lf)a.lawFirmName,#(lf)a.Enterprise_Name,#(lf)b.RVP as 'rvp',#(lf)first_visit,#(lf)b.region as 'firm_region',#(lf)fo.rank as 'facility_origination_rank',#(lf)fio.rank as 'firm_origination_rank',#(lf)so.rank as 'state_origination_rank',#(lf)rf.rank as 'facility_request_rank',#(lf)rfi.rank as 'firm_request_rank',#(lf)rs.rank as 'state_request_rank',#(lf)1 as 'Count',#(lf)time_to_acct as 'total_time_to_acct',#(lf)time_to_bill as 'total_time_to_bill',#(lf)s.column2 as 'appoitnment service',#(lf)a.State as 'firm_state',#(lf)case when c.count >= 50 then 1 else 0 end as 'high_vol_firm',#(lf)case when d.count >= 50 then 1 else 0 end as 'high_vol_fac',#(lf)case when g.count >= 50 then 1 else 0 end as 'high_vol_enterprise',#(lf)e.RVP as 'fac_rvp',#(lf)e.region as 'fac_region',#(lf)v.Firm_Group,#(lf)canceled,#(lf)a.case_coordinator,#(lf)Canceled_username,#(lf)Canceled_usertype,#(lf)scheduled_canceled,#(lf)canceled_status,#(lf)canceled_by_pt,#(lf)case when (a.facilityname like '%select PT%' or a.facilityname like '%select Physical Therapy%') then 'Select PT' #(lf)#(tab) when (a.facilityname like '%safeway%') then 'Safeway'#(lf)#(tab) when (a.facilityname like '%radnet%') then 'Radnet' #(lf)#(tab) when (a.facilityname like '%healix%') then 'Healix (In-Home)'#(lf)#(tab) when (a.facilityname like '%Bridge Healthcare%') then 'Bridge Healthcare' #(lf)#(tab) when (a.facilityname like '%Savas Health%') then 'Savas Health' #(lf)#(tab) else 'Standard Practice' end as 'Facility_Groups', #(lf)case when (a.facilityname like '%select PT%' or a.facilityname like '%select Physical Therapy%' or a.facilityname like '%safeway%') then 'Non-Standard Practice'#(lf)#(tab) when (a.facilityname like '%radnet%' or a.facilityname like '%healix%' or a.facilityname like '%Bridge Healthcare%'or a.facilityname like '%Savas Health%') #(lf)#(tab) then 'Do Not Schedule' #(lf)#(tab) else 'Standard Practice' end as 'Non-Standard/Do_Not_Schedule_Groups',#(lf)CASE WHEN a.region = 'Total Access' then re.precare_regions #(lf)#(tab)ELSE#(lf)#(tab)case when v.firm_group = 'Morgan & Morgan' then 'Morgan & Morgan'#(lf)#(tab)when a.facilitystate in ('CA', 'NV', 'UT', 'ID', 'MT', 'WY') then 'Western'#(lf)#(tab)when a.FacilityState in ('TX', 'LA', 'AR', 'MO', 'IL', 'WI','MN', 'IA', 'ND','SD','NE','KS') then 'Central'#(lf)#(tab)when a.FacilityState in ('MS','AL','GA','NC','SC','TN','VA','OH','MD','DC','IN','MI','WV','ME') then 'Eastern'#(lf)#(tab)else 'unlabeled' end end as 'scheduling regions',#(lf)#(tab)assigned_user#(lf)from #base a #(lf)LEFT JOIN analytics.dbo.serviceGroups s on a.requiresservices = s.column1#(lf)LEFT JOIN (SELECT FirmId, count(*) as 'count' from #base #(lf)where DateCreated >= @startdate group by FirmId) c on a.FirmId = c.FirmId#(lf)LEFT JOIN (SELECT FacilityId, count(*) as 'count' from #base #(lf)where DateCreated >= @startdate group by FacilityId) d on a.FacilityId = d.facilityid#(lf)LEFT JOIN (SELECT Enterprise_Name, count(*) as 'count' from #base #(lf)where DateCreated >= @startdate group by Enterprise_Name) g on a.Enterprise_Name = g.Enterprise_Name#(lf)LEFT JOIN Analytics.dbo.state_rvp b on a.State = b.state#(lf)LEFT JOIN Analytics.dbo.state_rvp e on a.FacilityState = e.state#(lf)LEFT JOIN #facorigination fo on a.facilityid = fo.Id#(lf)LEFT JOIN #reqbyfac rf on a.Facilityid = rf.FacilityId#(lf)LEFT JOIN #firmorigination fio on a.FirmId = fio.FirmID#(lf)LEFT JOIN #reqbyfirm rfi on a.FirmId = rfi.FirmId#(lf)LEFT JOIN #stateorigination so on a.FacilityState = so.FacilityState#(lf)LEFT JOIN #reqbystate rs on a.FacilityState = rs.FacilityState#(lf)left join analytics.dbo.vipfirms v on c.firmid = v.firm_id#(lf)LEFT JOIN analytics.dbo.firm_market_regions re ON re.state = a.facilitystate#(lf)where datecreated >= @startdate#(lf)--and Canceled_usertype = 'Admin'#(lf)and isnull(fundeddate, getdate()) <= eomonth(getdate())#(lf)order by DateCreated asc#(lf)#(lf)#(lf)/*#(lf)SELECT #(lf)    a.id,#(lf)    COUNT(*) as row_count#(lf)FROM #base a#(lf)GROUP BY a.id#(lf)HAVING COUNT(*) > 1#(lf)*/#(lf)"]),
				    #"Renamed Columns" = Table.RenameColumns(Source,{{"Enterprise_Name", "Enterprise"}})
				in
