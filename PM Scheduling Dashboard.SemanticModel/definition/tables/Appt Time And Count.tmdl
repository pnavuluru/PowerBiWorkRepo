			                && NOT ISBLANK('Appt Time And Count'[first_schedule_date])
			                && DATEDIFF('Appt Time And Count'[datecreated], 'Appt Time And Count'[first_schedule_date], DAY) > 7
			                && DATEDIFF('Appt Time And Count'[datecreated], 'Appt Time And Count'[first_schedule_date], DAY) <= 10
			        )
			    )
			)
		formatString: 0
		displayFolder: Schedule measures
		lineageTag: 31b0f810-34c4-4ecf-8df1-99caf1c0e8dc

	measure 'Scheduled 10+ Days' =
			
			CALCULATE(
			    DISTINCTCOUNT('Appt Time And Count'[id]),
			    KEEPFILTERS(
			        FILTER(
			            'Appt Time And Count',
			            NOT ISBLANK('Appt Time And Count'[datecreated])
			                && NOT ISBLANK('Appt Time And Count'[first_schedule_date])
			                && DATEDIFF('Appt Time And Count'[datecreated], 'Appt Time And Count'[first_schedule_date], DAY) > 10
			        )
			    )
			)
		formatString: 0
		displayFolder: Schedule measures
		lineageTag: 7c2f91d4-7ca2-4ec3-b476-af508157be96

	measure 'Selected SLA Metric' =
			
			VAR Metric = SELECTEDVALUE('SLA Metric Selector'[Metric], "Scheduled %")
			RETURN
			    SWITCH(
			        Metric,
			        "Scheduled %", [% Successfully Scheduled],
			        "Scheduled in 3D %", [% Scheduled in 0-3 Days],
			        "Scheduled in 7D %", [% Scheduled in 0-7 Days],
			        "Scheduled in 10D %", [% Scheduled in 0-10 Days],
			        "% Funded in 30 Days", [% Funded in 30 Days],
			        "% Funded in 60 Days", [% Funded in 60 Days],
			        "% Funded in 90 Days", [% Funded in 90 Days],
			        "% Successfully Scheduled", [% Successfully Scheduled],
			        "% Successfully Funded", [% Successfully Funded],
			        "Canceled %", [Canceled %],
			        BLANK()
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: SLA comparison
		lineageTag: d0f12825-d057-445e-8bce-d00bcc5ee0d4

	measure 'Current Volume' =
			
			VAR CurrentStart = MIN('Current Period Dates'[Date])
			VAR CurrentEnd = MAX('Current Period Dates'[Date])
			VAR HasCurrentDates = NOT ISBLANK(CurrentStart) && NOT ISBLANK(CurrentEnd)
			VAR CurrentEndExclusive = CurrentEnd + 1
			RETURN
			    IF(
			        HasCurrentDates,
			        CALCULATE(
			            [Total IDs],
			            FILTER(
			                ALL('Appt Time And Count'[datecreated]),
			                'Appt Time And Count'[datecreated] >= CurrentStart
			                    && 'Appt Time And Count'[datecreated] < CurrentEndExclusive
			            )
			        )
			    )
		formatString: 0
		displayFolder: SLA comparison
		lineageTag: 8f52ed18-3bdb-42f8-a946-7f4762d93566

	measure 'Prior Volume' =
			
			VAR PriorStart = MIN('Prior Period Dates'[Date])
			VAR PriorEnd = MAX('Prior Period Dates'[Date])
			VAR HasPriorDates = NOT ISBLANK(PriorStart) && NOT ISBLANK(PriorEnd)
			VAR PriorEndExclusive = PriorEnd + 1
			RETURN
			    IF(
			        HasPriorDates,
			        CALCULATE(
			            [Total IDs],
			            FILTER(
			                ALL('Appt Time And Count'[datecreated]),
			                'Appt Time And Count'[datecreated] >= PriorStart
			                    && 'Appt Time And Count'[datecreated] < PriorEndExclusive
			            )
			        )
			    )
		formatString: 0
		displayFolder: SLA comparison
		lineageTag: 737ce16f-2e0d-49d8-b907-e60f9600794c

	measure 'Current Metric' =
			
			VAR CurrentStart = MIN('Current Period Dates'[Date])
			VAR CurrentEnd = MAX('Current Period Dates'[Date])
			VAR HasCurrentDates = NOT ISBLANK(CurrentStart) && NOT ISBLANK(CurrentEnd)
			VAR CurrentEndExclusive = CurrentEnd + 1
			RETURN
			    IF(
			        HasCurrentDates,
			        CALCULATE(
			            [Selected SLA Metric],
			            FILTER(
			                ALL('Appt Time And Count'[datecreated]),
			                'Appt Time And Count'[datecreated] >= CurrentStart
			                    && 'Appt Time And Count'[datecreated] < CurrentEndExclusive
			            )
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: SLA comparison
		lineageTag: d2556530-f4fb-46a7-842b-f88f3f8f65c4

	measure 'Prior Metric' =
			
			VAR PriorStart = MIN('Prior Period Dates'[Date])
			VAR PriorEnd = MAX('Prior Period Dates'[Date])
			VAR HasPriorDates = NOT ISBLANK(PriorStart) && NOT ISBLANK(PriorEnd)
			VAR PriorEndExclusive = PriorEnd + 1
			RETURN
			    IF(
			        HasPriorDates,
			        CALCULATE(
			            [Selected SLA Metric],
			            FILTER(
			                ALL('Appt Time And Count'[datecreated]),
			                'Appt Time And Count'[datecreated] >= PriorStart
			                    && 'Appt Time And Count'[datecreated] < PriorEndExclusive
