	measure 'Metric Diff (Current-Prior)' = [Current Metric] - [Prior Metric]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: SLA comparison
		lineageTag: 91f28c51-1cb4-4a61-b41d-fa4dc0a8b621

	measure 'Impact 1 - Total Contribution (pp)' =
			VAR SelectedField = SELECTEDVALUE('Comparision Parameter'[Comparision Parameter Fields], "Appt Time And Count[firmname]")
			VAR IsFirmGroup = CONTAINSSTRING(SelectedField, "[Firm_Group]")
			VAR IsFirmRegion = CONTAINSSTRING(SelectedField, "[firm_region]")
			VAR IsFirmState = CONTAINSSTRING(SelectedField, "[firm_state]")
			VAR IsFirmName = CONTAINSSTRING(SelectedField, "[firmname]")
			VAR IsFacilityName = CONTAINSSTRING(SelectedField, "[facilityname]")
			VAR IsFacilityState = CONTAINSSTRING(SelectedField, "[FacilityState]")
			VAR IsEnterprise = CONTAINSSTRING(SelectedField, "[Enterprise]")
			VAR CurrentDenom =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup, CALCULATE([Current Volume], ALL('Appt Time And Count'[Firm_Group])),
			        IsFirmRegion, CALCULATE([Current Volume], ALL('Appt Time And Count'[firm_region])),
			        IsFirmState, CALCULATE([Current Volume], ALL('Appt Time And Count'[firm_state])),
			        IsFacilityName, CALCULATE([Current Volume], ALL('Appt Time And Count'[facilityname])),
			        IsFacilityState, CALCULATE([Current Volume], ALL('Appt Time And Count'[FacilityState])),
			        IsEnterprise, CALCULATE([Current Volume], ALL('Appt Time And Count'[Enterprise])),
			        CALCULATE([Current Volume], ALL('Appt Time And Count'[firmname]))
			    )
			VAR PriorDenom =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup, CALCULATE([Prior Volume], ALL('Appt Time And Count'[Firm_Group])),
			        IsFirmRegion, CALCULATE([Prior Volume], ALL('Appt Time And Count'[firm_region])),
			        IsFirmState, CALCULATE([Prior Volume], ALL('Appt Time And Count'[firm_state])),
			        IsFacilityName, CALCULATE([Prior Volume], ALL('Appt Time And Count'[facilityname])),
			        IsFacilityState, CALCULATE([Prior Volume], ALL('Appt Time And Count'[FacilityState])),
			        IsEnterprise, CALCULATE([Prior Volume], ALL('Appt Time And Count'[Enterprise])),
			        CALCULATE([Prior Volume], ALL('Appt Time And Count'[firmname]))
			    )
			VAR RowImpact =
			    VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			    VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			    RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			VAR IsRowScope =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup, ISINSCOPE('Appt Time And Count'[Firm_Group]),
			        IsFirmRegion, ISINSCOPE('Appt Time And Count'[firm_region]),
			        IsFirmState, ISINSCOPE('Appt Time And Count'[firm_state]),
			        IsFacilityName, ISINSCOPE('Appt Time And Count'[facilityname]),
			        IsFacilityState, ISINSCOPE('Appt Time And Count'[FacilityState]),
			        IsEnterprise, ISINSCOPE('Appt Time And Count'[Enterprise]),
			        ISINSCOPE('Appt Time And Count'[firmname])
			    )
			VAR TotalImpact =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup,
			            SUMX(
			                VALUES('Appt Time And Count'[Firm_Group]),
			                VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			            ),
			        IsFirmRegion,
			            SUMX(
			                VALUES('Appt Time And Count'[firm_region]),
			                VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			            ),
			        IsFirmState,
			            SUMX(
			                VALUES('Appt Time And Count'[firm_state]),
			                VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			            ),
			        IsFacilityName,
			            SUMX(
			                VALUES('Appt Time And Count'[facilityname]),
			                VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			            ),
			        IsFacilityState,
			            SUMX(
			                VALUES('Appt Time And Count'[FacilityState]),
			                VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			            ),
			        IsEnterprise,
			            SUMX(
			                VALUES('Appt Time And Count'[Enterprise]),
			                VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			            ),
			        SUMX(
			            VALUES('Appt Time And Count'[firmname]),
			            VAR CurrentShare = DIVIDE([Current Volume], CurrentDenom)
			            VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			            RETURN CurrentShare * [Current Metric] - PriorShare * [Prior Metric]
			        )
			    )
			RETURN IF(IsRowScope, RowImpact, TotalImpact)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: SLA comparison
		lineageTag: 3df2d8ce-8b21-4b3c-9f6b-26c1df07fd8e

	measure 'Impact 2 - Rate Effect (pp)' =
			VAR SelectedField = SELECTEDVALUE('Comparision Parameter'[Comparision Parameter Fields], "Appt Time And Count[firmname]")
			VAR IsFirmGroup = CONTAINSSTRING(SelectedField, "[Firm_Group]")
			VAR IsFirmRegion = CONTAINSSTRING(SelectedField, "[firm_region]")
			VAR IsFirmState = CONTAINSSTRING(SelectedField, "[firm_state]")
			VAR IsFirmName = CONTAINSSTRING(SelectedField, "[firmname]")
			VAR IsFacilityName = CONTAINSSTRING(SelectedField, "[facilityname]")
			VAR IsFacilityState = CONTAINSSTRING(SelectedField, "[FacilityState]")
			VAR IsEnterprise = CONTAINSSTRING(SelectedField, "[Enterprise]")
			VAR PriorDenom =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup, CALCULATE([Prior Volume], ALL('Appt Time And Count'[Firm_Group])),
			        IsFirmRegion, CALCULATE([Prior Volume], ALL('Appt Time And Count'[firm_region])),
			        IsFirmState, CALCULATE([Prior Volume], ALL('Appt Time And Count'[firm_state])),
			        IsFacilityName, CALCULATE([Prior Volume], ALL('Appt Time And Count'[facilityname])),
			        IsFacilityState, CALCULATE([Prior Volume], ALL('Appt Time And Count'[FacilityState])),
			        IsEnterprise, CALCULATE([Prior Volume], ALL('Appt Time And Count'[Enterprise])),
			        CALCULATE([Prior Volume], ALL('Appt Time And Count'[firmname]))
			    )
			VAR RowImpact =
			    VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			    RETURN PriorShare * ([Current Metric] - [Prior Metric])
			VAR IsRowScope =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup, ISINSCOPE('Appt Time And Count'[Firm_Group]),
			        IsFirmRegion, ISINSCOPE('Appt Time And Count'[firm_region]),
			        IsFirmState, ISINSCOPE('Appt Time And Count'[firm_state]),
			        IsFacilityName, ISINSCOPE('Appt Time And Count'[facilityname]),
			        IsFacilityState, ISINSCOPE('Appt Time And Count'[FacilityState]),
			        IsEnterprise, ISINSCOPE('Appt Time And Count'[Enterprise]),
			        ISINSCOPE('Appt Time And Count'[firmname])
			    )
			VAR TotalImpact =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup,
			            SUMX(
			                VALUES('Appt Time And Count'[Firm_Group]),
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN PriorShare * ([Current Metric] - [Prior Metric])
			            ),
			        IsFirmRegion,
			            SUMX(
			                VALUES('Appt Time And Count'[firm_region]),
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN PriorShare * ([Current Metric] - [Prior Metric])
			            ),
			        IsFirmState,
			            SUMX(
			                VALUES('Appt Time And Count'[firm_state]),
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN PriorShare * ([Current Metric] - [Prior Metric])
			            ),
			        IsFacilityName,
			            SUMX(
			                VALUES('Appt Time And Count'[facilityname]),
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN PriorShare * ([Current Metric] - [Prior Metric])
			            ),
			        IsFacilityState,
			            SUMX(
			                VALUES('Appt Time And Count'[FacilityState]),
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN PriorShare * ([Current Metric] - [Prior Metric])
			            ),
			        IsEnterprise,
			            SUMX(
			                VALUES('Appt Time And Count'[Enterprise]),
			                VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			                RETURN PriorShare * ([Current Metric] - [Prior Metric])
			            ),
			        SUMX(
			            VALUES('Appt Time And Count'[firmname]),
			            VAR PriorShare = DIVIDE([Prior Volume], PriorDenom)
			            RETURN PriorShare * ([Current Metric] - [Prior Metric])
			        )
			    )
			RETURN IF(IsRowScope, RowImpact, TotalImpact)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: SLA comparison
		lineageTag: 8321da04-e182-45c8-9215-c005f34a8f17

	measure 'Impact 3 - Mix Effect (pp)' =
			VAR SelectedField = SELECTEDVALUE('Comparision Parameter'[Comparision Parameter Fields], "Appt Time And Count[firmname]")
			VAR IsFirmGroup = CONTAINSSTRING(SelectedField, "[Firm_Group]")
			VAR IsFirmRegion = CONTAINSSTRING(SelectedField, "[firm_region]")
			VAR IsFirmState = CONTAINSSTRING(SelectedField, "[firm_state]")
			VAR IsFirmName = CONTAINSSTRING(SelectedField, "[firmname]")
			VAR IsFacilityName = CONTAINSSTRING(SelectedField, "[facilityname]")
			VAR IsFacilityState = CONTAINSSTRING(SelectedField, "[FacilityState]")
			VAR IsEnterprise = CONTAINSSTRING(SelectedField, "[Enterprise]")
			VAR CurrentDenom =
			    SWITCH(
			        TRUE(),
			        IsFirmGroup, CALCULATE([Current Volume], ALL('Appt Time And Count'[Firm_Group])),
			        IsFirmRegion, CALCULATE([Current Volume], ALL('Appt Time And Count'[firm_region])),
			        IsFirmState, CALCULATE([Current Volume], ALL('Appt Time And Count'[firm_state])),
			        IsFacilityName, CALCULATE([Current Volume], ALL('Appt Time And Count'[facilityname])),
			        IsFacilityState, CALCULATE([Current Volume], ALL('Appt Time And Count'[FacilityState])),
			        IsEnterprise, CALCULATE([Current Volume], ALL('Appt Time And Count'[Enterprise])),
			        CALCULATE([Current Volume], ALL('Appt Time And Count'[firmname]))
			    )
			VAR PriorDenom =
			    SWITCH(
