	partition 'Scheduling Breakdown' = m
		mode: import
		source =
				let
				    Source = Sql.Database("medprdsql02.canyonmedicalbilling.com", "financemetrics", [Query="#(lf)#(lf)IF OBJECT_ID('tempdb..#requests') IS NOT NULL DROP TABLE #requests #(lf)#(lf)select#(lf)#(tab)a.*,#(lf)#(tab)(select max(b.createddate) as scheduled from MoveDocsV4.dbo.AuditLogs b where module = 'Appointment Request' and newvalue = 'Appointment Scheduled'#(lf)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)and a.sourceid = b.sourceid) as date_scheduled#(lf)into #requests#(lf)from MoveDocsV4.dbo.AuditLogs a#(lf)where module = 'Appointment Request'#(lf)#(tab)and [action] = 'New Appointment Request'#(lf)#(lf)select#(lf)#(tab)a.*,#(lf)#(tab)case when a.date_scheduled is null then 0 else 1 end as conversion_flag,#(lf)#(tab)case when datepart(dw, a.createddate) = 1 #(lf)#(tab)then datediff(day,convert(date,a.createddate),convert(date,a.date_scheduled)) - 1 - (2*DATEDIFF(wk, convert(date,a.CreatedDate),convert(date,a.date_scheduled)))#(lf)#(tab)else datediff(day,convert(date,a.createddate),convert(date,a.date_scheduled)) - (2*DATEDIFF(wk, convert(date,a.CreatedDate),convert(date,a.date_scheduled))) end as days_to_schedule,#(lf)#(tab)eomonth(b.datecreated) as mo_requested,#(lf)#(tab)case when al.createdby not like '%@movedocs.com' and al.createdby not like '%@medportbilling.com' and al.createdby not like '%@lienservicinggroup.com'#(lf)and al.createdby not like '%@medport.com' and al.createdby not like '%@canyonmedicalbilling.com' and al.createdby not like '%@trimed-billing.com'#(lf)and al.createdby not like 'ssomb%' and al.createdby not like 'sssomb%' then 'External' when date_scheduled is null then null else 'Internal' end as ScheduledBy,#(lf)#(tab)b.facilitystate,#(lf)#(tab)b.facilityname, #(lf)        r.rvp,#(lf)        case when team = 'CS' then 'Scheduling' else team end as 'Region', #(lf)        vf.firm_group,#(lf)#(tab)b.requestedfirm,#(lf)#(tab)b.requiresservices as treatment_type#(lf)from #requests a#(lf)#(tab)left join movedocsv4.dbo.appointmentrequests b on a.sourceid = b.id#(lf)        left join analytics.dbo.state_rvp r on b.facilitystate = r.state#(lf)        left join [Analytics].[dbo].[VIPFirms] vf on replace(b.firmid,'undefined',null) = vf.firm_id#(lf)        left join analytics.dbo.scheduling_ownership so on so.appt_id = b.id#(lf)#(tab)#(tab)left join financemetrics.dbo._snapshot_cimianalysisanalytics caa on caa.AccountId = b.dosaccountid#(lf)#(tab)left join movedocsv4.dbo.auditlogs al on a.sourceid = al.sourceid and a.date_scheduled = al.createddate#(lf)#(tab)where #(lf)#(tab)location not like '%grs%'#(tab)#(tab)#(tab)and #(tab)#(lf)location not in ('IFA','IFI','OHF','OHC','TMC','TDC')#(tab)#(tab)#(tab)#(tab)"])
				in
				    Source

	annotation PBI_ResultType = Table

