			[Totalconversion]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 00d3c34b-8b26-42db-8b09-2d42fbe413de

		changedProperty = IsHidden

	measure Cumulativeconversionsum =
			
			calculate
			(
			sum
			('Scheduling Breakdown'[conversion_flag]),
			filter
			(
			ALLEXCEPT(
			'Scheduling Breakdown', 'Scheduling Breakdown'[facilityname],'Scheduling Breakdown'[facilitystate],'Scheduling Breakdown'[treatment_type],'Scheduling Breakdown'[mo_requested],'Scheduling Breakdown'[rvp],'Scheduling Breakdown'[requestedfirm],'Scheduling Breakdown'[firm_group],'Scheduling Breakdown'[Region]), 'Scheduling Breakdown'[days_to_schedule] <=
			max
			('Scheduling Breakdown'[days_to_schedule])))
		formatString: 0
		lineageTag: 292b894b-1d09-4154-a909-0b322fe5a9df

		changedProperty = IsHidden

	measure '% cumulativelyconverted' =
			
			divide
			(
			[Cumulativeconversionsum]
			,
			[TTLConversion]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e28f30e6-16cb-4be1-bf28-50589ef4a62f

		changedProperty = IsHidden

	measure TTLConversion = CALCULATE(COUNT('Scheduling Breakdown'[ID]),ALLEXCEPT('Scheduling Breakdown', 'Scheduling Breakdown'[facilityname],'Scheduling Breakdown'[facilitystate],'Scheduling Breakdown'[treatment_type],'Scheduling Breakdown'[mo_requested],'Scheduling Breakdown'[rvp],'Scheduling Breakdown'[requestedfirm],'Scheduling Breakdown'[firm_group],'Scheduling Breakdown'[Region]))
