	measure Totalconversion = calculate(count('Scheduling Breakdown'[ID]),ALLEXCEPT('Scheduling Breakdown', 'Scheduling Breakdown'[facilityname],'Scheduling Breakdown'[facilitystate],'Scheduling Breakdown'[treatment_type],'Scheduling Breakdown'[mo_requested],'Scheduling Breakdown'[rvp],'Scheduling Breakdown'[requestedfirm],'Scheduling Breakdown'[firm_group],'Scheduling Breakdown'[Region]))
		formatString: 0
